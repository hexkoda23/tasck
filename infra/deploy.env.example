# Non-secret per-environment settings read by infra/deploy.sh.
# Copy to infra/deploy.env (git-ignored) and fill in. Secrets never go here:
# they live in Key Vault (infra/set-secrets.sh or infra/import-env-secrets.sh).

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_FROM_EMAIL=noreply@example.com
SMTP_FROM_NAME=TASCK
SMTP_REPLY_TO=
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# Default Claude model for every AI feature.
AI_MODEL=claude-sonnet-4-5
ALIGNMENT_ANALYZER_TIMEOUT_SECONDS=75
ANALYZE_ALL_HARD_TIMEOUT_SECONDS=35
CREATOR_MATCH_TIMEOUT_SECONDS=50

# Optional overrides also honoured by deploy.sh:
# RG=rg-tasck-prod LOCATION=westeurope ENV_NAME=prod MONGO_TIER=M10
# EXTRA_CORS_ORIGINS=https://www.example.com PUBLIC_APP_URL=https://app.example.com
# ENABLE_DEMO_LOGIN=true
# CUSTOM_DOMAIN=example.com CUSTOM_DOMAIN_VALIDATION_METHOD=HTTP
