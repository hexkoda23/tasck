# Local development only.
#
# Precedence: a value already in the process environment always wins; this file
# only fills gaps, and it is only read when APP_ENV is development/dev/local/test.
# On Azure the API gets everything from Container App settings and Key Vault
# references, and this file is not in the image.

APP_ENV=development

# --- Database ---------------------------------------------------------------
MONGO_URL=mongodb://localhost:27017
DB_NAME=tasck_local

# --- Web / URLs -------------------------------------------------------------
# Comma-separated browser origins allowed to call the API directly. Not needed
# when the web tier proxies /api on the same origin.
CORS_ORIGINS=http://localhost:3000
# Public URL of the frontend, used in emails and portal links.
FRONTEND_URL=http://localhost:3000
PUBLIC_APP_URL=http://localhost:3000
BRAND_PORTAL_URL=
CREATOR_PORTAL_URL=

# --- Startup behaviour ------------------------------------------------------
# Seed demo accounts / run one-off local data hydration on boot. Ignored (always
# off) outside local environments.
ENABLE_DEMO_BOOTSTRAP=true
# Passwordless role login used by the V1 admin/staff/creative sign-in. Defaults
# to enabled to preserve current behaviour; set false once a credentialed admin
# login exists.
ENABLE_DEMO_LOGIN=true
ENABLE_DIAGNOSTICS=false
ENABLE_ADMIN_CLEANUP=false
# Never set WIPE_DEMO_DATA_ONCE on a database holding real data.

# --- AI ---------------------------------------------------------------------
# anthropic = Claude via the Anthropic API (the Azure configuration).
TASCK_AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ALIGNMENT_ANALYZER_MODEL=claude-sonnet-4-5
ALIGNMENT_ANALYZER_TIMEOUT_SECONDS=75
ANALYZE_ALL_HARD_TIMEOUT_SECONDS=350
CREATOR_MATCH_TIMEOUT_SECONDS=50
# Optional per-feature model overrides (default to ALIGNMENT_ANALYZER_MODEL):
# BRAND_ABOUT_LLM_MODEL, BRAINSTORM_LLM_MODEL, CREATOR_MATCH_LLM_MODEL,
# CREATIVE_BRIEF_LLM_MODEL, PITCH_DECK_LLM_MODEL, OPPORTUNITY_LLM_MODEL,
# OPPORTUNITY_SCANNER_LLM_MODEL, IMPORT_EXTRACT_LLM_MODEL, TRACKER_LLM_MODEL

# --- Opportunity scanning ---------------------------------------------------
SERPAPI_API_KEY=

# --- Email (SMTP, STARTTLS) -------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=TASCK
SMTP_REPLY_TO=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
