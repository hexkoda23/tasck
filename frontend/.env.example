# Embedded into the bundle at build time (Create React App). Not a secret.
#
# Local dev: the API's origin.
REACT_APP_BACKEND_URL=http://localhost:8001
#
# Azure: the PUBLIC web hostname (nginx proxies /api to the API container), e.g.
# REACT_APP_BACKEND_URL=https://tasck-web.<env>.azurecontainerapps.io
# It is passed as a --build-arg to Dockerfile.web; this file is not used there.
