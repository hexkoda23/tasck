# Local development only. Copy to .env and adjust.
#
# Production (Azure) builds set REACT_APP_BACKEND_URL to an empty string so the
# browser calls the same-origin /api, which nginx proxies to tasck-api.
# For local development against a locally running API:
REACT_APP_BACKEND_URL=http://localhost:8000
WDS_SOCKET_PORT=0
ENABLE_HEALTH_CHECK=false
